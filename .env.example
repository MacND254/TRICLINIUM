# ==============================================================================
# TRICLINIUM PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Pooled connection string (used by Prisma in production serverless execution)
DATABASE_URL="postgresql://triclinium_user:YOUR_PASSWORD@ep-sample-pooler.us-east-2.aws.neon.tech/triclinium?sslmode=require&pgbouncer=true"

# Direct unpooled connection string (used for schema migrations and CLI operations)
DIRECT_DATABASE_URL="postgresql://triclinium_user:YOUR_PASSWORD@ep-sample.us-east-2.aws.neon.tech/triclinium?sslmode=require"

# ------------------------------------------------------------------------------
# 2. REDIS CACHING & RATE LIMITING (Upstash Redis)
# ------------------------------------------------------------------------------
# Upstash REST API credentials (compatible with serverless function stateless execution)
UPSTASH_REDIS_REST_URL="https://sample-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_UPSTASH_REST_TOKEN"

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens and secure session cookies (min 32 chars)
AUTH_SECRET="f94a8c3d2e1b7654098fedcba0123456789abcdef0123456789abcdef0123456"

# Session expiration time in seconds (e.g., 604800 = 7 days)
SESSION_MAX_AGE="604800"

# CORS configuration: comma-separated allowed origins
CORS_ORIGIN="http://localhost:3000,https://triclinium.com,https://www.triclinium.com"

# Internal shared secret for Next.js On-Demand ISR Revalidation
INTERNAL_REVALIDATION_SECRET="triclinium_revalidation_secret_key_8842"

# ------------------------------------------------------------------------------
# 4. APPLICATION URLS
# ------------------------------------------------------------------------------
# Backend API listener port (for local development)
PORT="4000"

# Backend API base URL
API_URL="http://localhost:4000"

# Frontend website base URL
FRONTEND_URL="http://localhost:3000"

# Public URL used in Next.js metadata, sitemaps, and robots.txt
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Public API endpoint used by client-side browser requests
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# ------------------------------------------------------------------------------
# 5. MEDIA & ASSET STORAGE (Cloudinary)
# ------------------------------------------------------------------------------
# Cloudinary credentials for media upload, asset transformation, and persistent storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ------------------------------------------------------------------------------
# 6. TRANSACTIONAL EMAIL (Resend)
# ------------------------------------------------------------------------------
# Resend API key for inquiry alerts, quotations, password resets, and notifications
RESEND_API_KEY="re_sample_1234567890abcdef"
EMAIL_SENDER_NAME="TRICLINIUM Commercial & Industrial Enterprise"
EMAIL_SENDER_ADDRESS="notifications@triclinium.com"
ADMIN_NOTIFICATION_EMAIL="admin@triclinium.com"

# ------------------------------------------------------------------------------
# 7. INITIAL SUPER ADMIN SEED CREDENTIALS
# ------------------------------------------------------------------------------
INITIAL_SUPER_ADMIN_EMAIL="admin@triclinium.com"
INITIAL_SUPER_ADMIN_PASSWORD="ChangeMeInProduction123!@#"
INITIAL_SUPER_ADMIN_FIRST_NAME="System"
INITIAL_SUPER_ADMIN_LAST_NAME="Administrator"
